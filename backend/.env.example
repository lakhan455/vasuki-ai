APP_NAME=Power Vasuki AI
APP_ENV=development
ALLOWED_ORIGINS=http://localhost:3000

# Chat providers (configure at least one)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
SAMBANOVA_API_KEY=
SAMBANOVA_MODEL=gpt-oss-120b
SAMBANOVA_BASE_URL=https://api.sambanova.ai/v1
CEREBRAS_API_KEY=
CEREBRAS_MODEL=gpt-oss-120b
CEREBRAS_BASE_URL=https://api.cerebras.ai/v1
GOOGLE_GEMINI_API=
GEMINI_MODEL=gemini-3.6-flash
GEMINI_VISION_MODEL=gemini-3.6-flash
GEMINI_IMAGE_EDIT_MODEL=gemini-3.1-flash-image
OPENROUTER_API=
OPENROUTER_MODEL=openai/gpt-4.1-mini
MISTRAL_AI_API=
MISTRAL_MODEL=mistral-small-latest

# Research providers
TAVILY_API_KEY=
EXA_API=
NEWS_API=

# Image / OCR providers
DEEPAI_API=
HUGGING_FACE_INFERENCE_API=
HF_IMAGE_MODEL=black-forest-labs/FLUX.1-schnell
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_WORKERS_AI=
CLOUDFLARE_IMAGE_MODEL=@cf/black-forest-labs/flux-1-schnell
CLOUDFLARE_VISION_MODEL=@cf/moondream/moondream3.1-9B-A2B
CLOUDFLARE_EDIT_MODEL=@cf/black-forest-labs/flux-2-klein-4b
OCR_SPACE_API=

# Safety / limits
REQUEST_TIMEOUT_SECONDS=60
MAX_PROMPT_CHARS=20000
VISION_TIMEOUT_SECONDS=120
VISION_MAX_FILE_MB=15

# Personal memory + document RAG
GEMINI_EMBEDDING_MODEL=gemini-embedding-2
EMBEDDING_DIMENSIONS=768
DOCUMENT_MAX_MB=15
DOCUMENT_MAX_CHUNKS=120
DOCUMENT_MATCH_COUNT=8


# Vasuki Pro / Puter / Razorpay
VASUKI_OWNER_EMAILS=your-google-login-email@example.com
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_PLAN_AMOUNT_PAISE=9900
RAZORPAY_PLAN_DAYS=30
