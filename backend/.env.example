APP_NAME=Power Vasuki AI
APP_ENV=development
ALLOWED_ORIGINS=http://localhost:3000

# Chat providers (configure at least one)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
SAMBANOVA_API_KEY=
SAMBANOVA_MODEL=gpt-oss-120b
SAMBANOVA_BASE_URL=https://api.sambanova.ai/v1
CEREBRAS_API_KEY=
CEREBRAS_MODEL=gpt-oss-120b
CEREBRAS_BASE_URL=https://api.cerebras.ai/v1
GOOGLE_GEMINI_API=
GEMINI_MODEL=gemini-3.6-flash
GEMINI_VISION_MODEL=gemini-3.6-flash
GEMINI_IMAGE_EDIT_MODEL=gemini-3.1-flash-image
OPENROUTER_API=
OPENROUTER_MODEL=openai/gpt-4.1-mini

# VASUKI_V42_DUAL_PROVIDER_START
# Backend-only. Never commit real keys.
OPENCODE_ZEN_API_KEY=
OPENCODE_ZEN_BASE_URL=https://opencode.ai/zen/v1
OPENCODE_ZEN_MODEL=north-mini-code-free
OPENCODE_ZEN_TIMEOUT_SECONDS=45

# Optional OpenRouter image fallback. May consume paid OpenRouter credits.
OPENROUTER_IMAGE_ENABLED=false
OPENROUTER_IMAGE_MODEL=
# VASUKI_V42_DUAL_PROVIDER_END
MISTRAL_AI_API=
MISTRAL_MODEL=mistral-small-latest

# Research providers
TAVILY_API_KEY=
EXA_API=
NEWS_API=

# Image / OCR providers
DEEPAI_API=
HUGGING_FACE_INFERENCE_API=
HF_IMAGE_MODEL=black-forest-labs/FLUX.1-schnell
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_WORKERS_AI=
CLOUDFLARE_IMAGE_MODEL=@cf/black-forest-labs/flux-1-schnell
CLOUDFLARE_VISION_MODEL=@cf/moondream/moondream3.1-9B-A2B
CLOUDFLARE_EDIT_MODEL=@cf/black-forest-labs/flux-2-klein-4b
OCR_SPACE_API=

# Safety / limits
REQUEST_TIMEOUT_SECONDS=60
MAX_PROMPT_CHARS=20000
VISION_TIMEOUT_SECONDS=120
VISION_MAX_FILE_MB=15

# Personal memory + document RAG
GEMINI_EMBEDDING_MODEL=gemini-embedding-2
EMBEDDING_DIMENSIONS=768
DOCUMENT_MAX_MB=15
DOCUMENT_MAX_CHUNKS=120
DOCUMENT_MATCH_COUNT=8


# Vasuki Pro / Puter / Razorpay
VASUKI_OWNER_EMAILS=your-google-login-email@example.com
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_PLAN_AMOUNT_PAISE=9900
RAZORPAY_PLAN_DAYS=30
PUTER_FREE_FOR_ALL=true
PUTER_IMAGE_DAILY_LIMIT=100

# VASUKI_V11_ALL_IN_ONE_START
# V11 quality / research / canary
V11_EVAL_CONCURRENCY=3
V11_RESEARCH_MAX_SUBQUESTIONS=6
V11_CANARY_PERCENT=5
V11_ABUSE_REQUESTS_PER_MINUTE=120

# Persistent scheduler. Exact wake timing on sleeping free hosts needs an external wake/cron.
V11_SCHEDULER_ENABLED=true
V11_SCHEDULER_POLL_SECONDS=60

# Rollback guard. Leave disabled until a deployment rollback webhook is configured.
V11_AUTO_ROLLBACK_ENABLED=false
V11_ROLLBACK_MIN_SAMPLES=50
V11_ROLLBACK_ERROR_PCT=12
V11_ROLLBACK_WEBHOOK_URL=

# OmniRoute runtime flags are separate from embedded knowledge.
V11_MCP_ENABLED=false
V11_A2A_ENABLED=false

# Backend-only GitHub integration. Never put this token in Vercel/frontend.
V11_GITHUB_TOKEN=

# Optional OpenAI-compatible video provider.
V11_VIDEO_API_BASE_URL=
V11_VIDEO_API_KEY=
V11_VIDEO_MODEL=auto

# Optional server audio providers. Browser speech-to-speech works without these.
V11_TTS_API_BASE_URL=
V11_TTS_API_KEY=
V11_TTS_MODEL=tts-1
V11_STT_API_BASE_URL=
V11_STT_API_KEY=
V11_STT_MODEL=whisper-1
# VASUKI_V11_ALL_IN_ONE_END
# VASUKI_V41_LIVE_WEATHER_TOOL_START
# Backend-only. Add the real value only in backend/Render environment variables.
WEATHERAPI_KEY=
WEATHERAPI_BASE_URL=https://api.weatherapi.com/v1
WEATHERAPI_TIMEOUT_SECONDS=9
# VASUKI_V41_LIVE_WEATHER_TOOL_END
